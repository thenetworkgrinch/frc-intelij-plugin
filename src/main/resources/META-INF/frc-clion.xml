<!-- C++ robot project support. Loaded only when CLion's Compilation Database plugin is available (i.e. in CLion). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity id="FRC.WpiLibCppCompilationDatabaseStartupActivity" implementation="net.javaru.iip.frc.cpp.WpiLibCppCompilationDatabaseStartupActivity" />
    </extensions>

    <actions>
        <action id="frc.cpp.RegenerateCppCompileCommandsAction"
                class="net.javaru.iip.frc.cpp.RegenerateCppCompileCommandsAction"
                icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="FRC.FrcToolsActionsGroup" anchor="after" relative-to-action="frc.tools.CheckForWpiLibUpdateAction" />
        </action>
        <action id="frc.cpp.SelectCppCodeInsightTargetAction"
                class="net.javaru.iip.frc.cpp.SelectCppCodeInsightTargetAction">
            <add-to-group group-id="FRC.FrcToolsActionsGroup" anchor="after" relative-to-action="frc.cpp.RegenerateCppCompileCommandsAction" />
        </action>
    </actions>
</idea-plugin>
